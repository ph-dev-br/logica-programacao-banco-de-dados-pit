programa {
  /*
   * Questão 13 
   *
   * Faça um algoritmo que receba o valor de x,
   * e calcule e imprima o valor de f(x).
   *
   * f(x) = 8 / (2 - x)
   */
  funcao inicio() {
    real x
    escreva("Digite o valor de X: ")
    leia(x)

    real resultado = 8 / (2 - x)
    escreva("\nO resultado da função é: ", x)
  }
}
