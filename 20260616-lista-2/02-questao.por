programa {
  /*
   * Questão 02
   *
   * Faça um algoritmo que efetue a leitura de um valor numérico inteiro
   * e apresente o resultado do valor lido elevado ao quadrado.
   *
   */
  funcao inicio() {
    inteiro numero
    escreva("Digite um número: ")
    leia(numero)

    inteiro quadradoNumero = numero * numero
    escreva("\nO quadrado do número digitado é: ", quadradoNumero)
  }
}
